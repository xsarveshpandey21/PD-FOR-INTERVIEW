# Database Connection String
# Local SQLite default (For LAN multi-device access: all devices connect to host IP e.g. http://192.168.x.x:3000)
DATABASE_URL="file:./prisma/dev.db"

# Admin Authentication & Security JWT Secret
JWT_SECRET="your_jwt_secret_key_change_in_production"
ADMIN_DEFAULT_USERNAME="admin@example.com"
ADMIN_DEFAULT_PASSWORD="your_secure_password"

# Candidate Configuration Flags
SHOW_SCORE_TO_STUDENT="false"

# Gemini AI Integration API Key
GEMINI_API_KEY=""
